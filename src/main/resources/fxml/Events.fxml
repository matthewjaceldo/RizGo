<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<StackPane xmlns="http://javafx.com/javafx/21"
           xmlns:fx="http://javafx.com/fxml"
           fx:controller="com.rizgo.controllers.EventsController"
           stylesheets="@../css/rizgo.css"
           styleClass="appBackground">

    <BorderPane maxWidth="430"
                styleClass="eventsRoot">

        <!-- ================= HEADER ================= -->

        <top>

            <VBox spacing="10"
                  styleClass="eventsHeader">

                <padding>
                    <Insets top="14"
                            right="16"
                            bottom="12"
                            left="16"/>
                </padding>

                <GridPane>

                    <columnConstraints>

                        <ColumnConstraints minWidth="45"
                                           prefWidth="45"
                                           maxWidth="45"/>

                        <ColumnConstraints hgrow="ALWAYS"/>

                        <ColumnConstraints minWidth="45"
                                           prefWidth="45"
                                           maxWidth="45"/>

                    </columnConstraints>

                    <Button text="←"
                            onAction="#goBack"
                            GridPane.columnIndex="0"
                            styleClass="eventsBackButton"/>

                    <Label text="Events"
                           GridPane.columnIndex="1"
                           GridPane.halignment="CENTER"
                           styleClass="eventsPageTitle"/>

                    <Region GridPane.columnIndex="2"/>

                </GridPane>


                <!-- SEARCH -->

                <HBox alignment="CENTER_LEFT"
                      spacing="8"
                      styleClass="eventsSearchContainer">

                    <Label text="⌕"
                           styleClass="eventsSearchIcon"/>

                    <TextField fx:id="searchField"
                               promptText="Search event..."
                               onKeyReleased="#searchEvents"
                               HBox.hgrow="ALWAYS"
                               styleClass="eventsSearchField"/>

                </HBox>

            </VBox>

        </top>


        <!-- ================= CENTER ================= -->

        <center>

            <ScrollPane fitToWidth="true"
                        hbarPolicy="NEVER"
                        vbarPolicy="AS_NEEDED"
                        styleClass="eventsScroll">

                <content>

                    <VBox fx:id="eventList"
                          spacing="12"
                          fillWidth="true">

                        <padding>
                            <Insets top="14"
                                    right="14"
                                    bottom="20"
                                    left="14"/>
                        </padding>


                        <!-- ================= EVENT 1 ================= -->

                        <VBox spacing="9"
                              styleClass="eventCard">

                            <HBox alignment="CENTER_LEFT"
                                  spacing="10">

                                <Label text="🏀"
                                       styleClass="eventIcon"/>

                                <VBox spacing="2"
                                      HBox.hgrow="ALWAYS">

                                    <Label text="Intramurals 2026"
                                           styleClass="eventTitle"/>

                                    <Label text="Sports Event"
                                           styleClass="eventType"/>

                                </VBox>

                                <Label text="›"
                                       styleClass="eventArrow"/>

                            </HBox>

                            <Separator/>

                            <Label text="Annual school intramurals featuring sports competitions and student activities."
                                   wrapText="true"
                                   styleClass="eventDescription"/>

                            <HBox alignment="CENTER_LEFT"
                                  spacing="14">

                                <Label text="📅 August 20, 2026"
                                       styleClass="eventMeta"/>

                                <Label text="📍 RHS Oval"
                                       styleClass="eventMeta"/>

                            </HBox>

                        </VBox>


                        <!-- ================= EVENT 2 ================= -->

                        <VBox spacing="9"
                              styleClass="eventCard">

                            <HBox alignment="CENTER_LEFT"
                                  spacing="10">

                                <Label text="🎭"
                                       styleClass="eventIcon"/>

                                <VBox spacing="2"
                                      HBox.hgrow="ALWAYS">

                                    <Label text="School Program"
                                           styleClass="eventTitle"/>

                                    <Label text="School Activity"
                                           styleClass="eventType"/>

                                </VBox>

                                <Label text="›"
                                       styleClass="eventArrow"/>

                            </HBox>

                            <Separator/>

                            <Label text="A school-wide program featuring student performances, presentations, and activities."
                                   wrapText="true"
                                   styleClass="eventDescription"/>

                            <HBox alignment="CENTER_LEFT"
                                  spacing="14">

                                <Label text="📅 September 5, 2026"
                                       styleClass="eventMeta"/>

                                <Label text="📍 Tanghalang Rizal"
                                       styleClass="eventMeta"/>

                            </HBox>

                        </VBox>


                        <!-- ================= EVENT 3 ================= -->

                        <VBox spacing="9"
                              styleClass="eventCard">

                            <HBox alignment="CENTER_LEFT"
                                  spacing="10">

                                <Label text="📚"
                                       styleClass="eventIcon"/>

                                <VBox spacing="2"
                                      HBox.hgrow="ALWAYS">

                                    <Label text="Academic Week"
                                           styleClass="eventTitle"/>

                                    <Label text="Academic Event"
                                           styleClass="eventType"/>

                                </VBox>

                                <Label text="›"
                                       styleClass="eventArrow"/>

                            </HBox>

                            <Separator/>

                            <Label text="A week of academic activities, exhibits, and student-led presentations."
                                   wrapText="true"
                                   styleClass="eventDescription"/>

                            <HBox alignment="CENTER_LEFT"
                                  spacing="14">

                                <Label text="📅 October 12–16, 2026"
                                       styleClass="eventMeta"/>

                                <Label text="📍 Main Campus"
                                       styleClass="eventMeta"/>

                            </HBox>

                        </VBox>


                        <!-- ================= EVENT 4 ================= -->

                        <VBox spacing="9"
                              styleClass="eventCard">

                            <HBox alignment="CENTER_LEFT"
                                  spacing="10">

                                <Label text="🎓"
                                       styleClass="eventIcon"/>

                                <VBox spacing="2"
                                      HBox.hgrow="ALWAYS">

                                    <Label text="Recognition Program"
                                           styleClass="eventTitle"/>

                                    <Label text="Recognition Event"
                                           styleClass="eventType"/>

                                </VBox>

                                <Label text="›"
                                       styleClass="eventArrow"/>

                            </HBox>

                            <Separator/>

                            <Label text="A recognition program honoring student achievement and participation."
                                   wrapText="true"
                                   styleClass="eventDescription"/>

                            <HBox alignment="CENTER_LEFT"
                                  spacing="14">

                                <Label text="📅 November 28, 2026"
                                       styleClass="eventMeta"/>

                                <Label text="📍 Tanghalang Rizal"
                                       styleClass="eventMeta"/>

                            </HBox>

                        </VBox>

                    </VBox>

                </content>

            </ScrollPane>

        </center>


        <!-- ================= BOTTOM NAV ================= -->

        <bottom>

            <HBox alignment="CENTER"
                  spacing="6"
                  styleClass="newBottomBar">

                <Button text="⌂&#10;Home"
                        onAction="#goHome"
                        styleClass="bottomNavButton"/>

                <Button text="⌖&#10;Map"
                        onAction="#openMap"
                        styleClass="bottomNavButton"/>

                <Button text="◉&#10;Chat"
                        onAction="#openChat"
                        styleClass="bottomNavButton"/>

                <Button text="♙&#10;Profile"
                        onAction="#openProfile"
                        styleClass="bottomNavButton"/>

            </HBox>

        </bottom>

    </BorderPane>

</StackPane>