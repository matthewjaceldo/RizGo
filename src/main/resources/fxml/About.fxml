<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<StackPane xmlns="http://javafx.com/javafx/21"
           xmlns:fx="http://javafx.com/fxml"
           fx:controller="com.rizgo.controllers.AboutController"
           stylesheets="@../css/rizgo.css"
           styleClass="appBackground">

    <BorderPane maxWidth="430"
                styleClass="aboutRoot">

        <!-- ================= HEADER ================= -->

        <top>

            <VBox spacing="10"
                  styleClass="aboutHeader">

                <padding>
                    <Insets top="14"
                            right="16"
                            bottom="12"
                            left="16"/>
                </padding>

                <GridPane>

                    <columnConstraints>
                        <ColumnConstraints minWidth="45"
                                           prefWidth="45"
                                           maxWidth="45"/>

                        <ColumnConstraints hgrow="ALWAYS"/>

                        <ColumnConstraints minWidth="45"
                                           prefWidth="45"
                                           maxWidth="45"/>
                    </columnConstraints>

                    <Button text="←"
                            onAction="#goBack"
                            GridPane.columnIndex="0"
                            styleClass="aboutBackButton"/>

                    <Label text="About RizGo"
                           GridPane.columnIndex="1"
                           GridPane.halignment="CENTER"
                           styleClass="aboutPageTitle"/>

                    <Region GridPane.columnIndex="2"/>

                </GridPane>

            </VBox>

        </top>


        <!-- ================= CENTER ================= -->

        <center>

            <ScrollPane fitToWidth="true"
                        hbarPolicy="NEVER"
                        vbarPolicy="AS_NEEDED"
                        styleClass="aboutScroll">

                <content>

                    <VBox spacing="14"
                          fillWidth="true">

                        <padding>
                            <Insets top="16"
                                    right="14"
                                    bottom="22"
                                    left="14"/>
                        </padding>


                        <!-- ================= BRAND ================= -->

                        <VBox alignment="CENTER"
                              spacing="6"
                              styleClass="aboutHeroCard">

                            <Label text="RizGo"
                                   styleClass="aboutLogo"/>

                            <Label text="Rizalians. Navigate. Discover."
                                   styleClass="aboutTagline"/>

                            <Label text="Your campus guide for Rizal High School."
                                   wrapText="true"
                                   textAlignment="CENTER"
                                   styleClass="aboutHeroDescription"/>

                        </VBox>


                        <!-- ================= ABOUT ================= -->

                        <VBox spacing="9"
                              styleClass="aboutCard">

                            <Label text="What is RizGo?"
                                   styleClass="aboutSectionTitle"/>

                            <Separator/>

                            <Label text="RizGo is a campus assistance system designed to help students navigate Rizal High School and access important school information more easily."
                                   wrapText="true"
                                   styleClass="aboutBodyText"/>

                        </VBox>


                        <!-- ================= PURPOSE ================= -->

                        <VBox spacing="9"
                              styleClass="aboutCard">

                            <Label text="Purpose"
                                   styleClass="aboutSectionTitle"/>

                            <Separator/>

                            <Label text="RizGo helps users locate buildings, offices and facilities, view school information, access services, read announcements, check events, and use the campus AI assistant."
                                   wrapText="true"
                                   styleClass="aboutBodyText"/>

                        </VBox>


                        <!-- ================= FEATURES ================= -->

                        <VBox spacing="9"
                              styleClass="aboutCard">

                            <Label text="Main Features"
                                   styleClass="aboutSectionTitle"/>

                            <Separator/>

                            <Label text="• Interactive Campus Map"
                                   styleClass="aboutFeatureText"/>

                            <Label text="• AI Campus Assistant"
                                   styleClass="aboutFeatureText"/>

                            <Label text="• Offices and Facilities Directory"
                                   styleClass="aboutFeatureText"/>

                            <Label text="• School Services"
                                   styleClass="aboutFeatureText"/>

                            <Label text="• Announcements and Events"
                                   styleClass="aboutFeatureText"/>

                            <Label text="• Emergency Information"
                                   styleClass="aboutFeatureText"/>

                        </VBox>


                        <!-- ================= SCHOOL ================= -->

                        <VBox spacing="9"
                              styleClass="aboutCard">

                            <Label text="School"
                                   styleClass="aboutSectionTitle"/>

                            <Separator/>

                            <Label text="Rizal High School"
                                   styleClass="aboutInfoTitle"/>

                            <Label text="RizGo is designed as a digital campus guide for Rizalians."
                                   wrapText="true"
                                   styleClass="aboutBodyText"/>

                        </VBox>


                        <!-- ================= VERSION ================= -->

                        <VBox spacing="7"
                              alignment="CENTER"
                              styleClass="aboutVersionCard">

                            <Label text="RizGo"
                                   styleClass="aboutVersionTitle"/>

                            <Label text="Version 1.0"
                                   styleClass="aboutVersionText"/>

                            <Label text="Campus Guide System"
                                   styleClass="aboutVersionText"/>

                        </VBox>

                    </VBox>

                </content>

            </ScrollPane>

        </center>


        <!-- ================= BOTTOM NAV ================= -->

        <bottom>

            <HBox alignment="CENTER"
                  spacing="6"
                  styleClass="newBottomBar">

                <Button text="⌂&#10;Home"
                        onAction="#goHome"
                        styleClass="bottomNavButton"/>

                <Button text="⌖&#10;Map"
                        onAction="#openMap"
                        styleClass="bottomNavButton"/>

                <Button text="◉&#10;Chat"
                        onAction="#openChat"
                        styleClass="bottomNavButton"/>

                <Button text="♙&#10;Profile"
                        onAction="#openProfile"
                        styleClass="bottomNavButton"/>

            </HBox>

        </bottom>

    </BorderPane>

</StackPane>