<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<StackPane xmlns="http://javafx.com/javafx/21"
           xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="com.rizgo.controllers.LoginController"
           stylesheets="@../css/rizgo.css"
           styleClass="loginPageRoot">

    <VBox alignment="CENTER"
          spacing="18"
          maxWidth="390"
          styleClass="loginCard">

        <padding>
            <Insets top="35"
                    right="30"
                    bottom="35"
                    left="30"/>
        </padding>

        <!-- LOGO -->

        <Label text="RizGo"
               styleClass="loginLogo"/>

        <Label text="Rizalians. Navigate. Discover."
               styleClass="loginTagline"/>

        <Region prefHeight="12"/>


        <!-- WELCOME -->

        <Label text="Welcome Back"
               styleClass="loginTitle"/>

        <Label text="Sign in to continue to RizGo."
               styleClass="loginSubtitle"/>

        <!-- EMAIL -->

        <VBox spacing="5"
              maxWidth="Infinity">

            <Label text="Email"
                   styleClass="loginFieldLabel"/>

            <TextField fx:id="emailField"
                       promptText="Enter your email"
                       styleClass="loginInput"/>

        </VBox>


        <!-- PASSWORD -->

        <VBox spacing="5"
              maxWidth="Infinity">

            <Label text="Password"
                   styleClass="loginFieldLabel"/>

            <StackPane>

                <PasswordField fx:id="passwordField"
                               promptText="Enter your password"
                               styleClass="loginInput"
                               maxWidth="Infinity"/>

                <TextField fx:id="visiblePasswordField"
                           promptText="Enter your password"
                           styleClass="loginInput"
                           maxWidth="Infinity"
                           visible="false"
                           managed="false"/>

            </StackPane>

        </VBox>


        <!-- SHOW PASSWORD -->

        <HBox alignment="CENTER_LEFT">

            <CheckBox fx:id="showPasswordCheckBox"
                      text="Show Password"
                      onAction="#togglePassword"
                      styleClass="loginCheckBox"/>

            <Pane HBox.hgrow="ALWAYS"/>

            <Hyperlink text="Forgot Password?"
                       styleClass="loginLink"/>

        </HBox>


        <!-- LOGIN BUTTON -->

        <Button text="LOGIN"
                onAction="#handleLogin"
                maxWidth="Infinity"
                styleClass="loginPrimaryButton"/>


        <Button text="CONTINUE AS GUEST"
                maxWidth="Infinity"
                prefHeight="50"
                onAction="#continueAsGuest"
                styleClass="guestButton"/>


        <!-- DIVIDER -->

        <HBox alignment="CENTER"
              spacing="10">

            <Separator HBox.hgrow="ALWAYS"/>

            <Label text="OR"
                   styleClass="loginOrText"/>

            <Separator HBox.hgrow="ALWAYS"/>

        </HBox>


        <!-- SIGN UP -->

        <HBox alignment="CENTER"
              spacing="5">

            <Label text="Don't have an account?"
                   styleClass="loginBottomText"/>

            <Hyperlink text="Sign Up"
                       onAction="#openSignup"
                       styleClass="loginSignupLink"/>

        </HBox>

    </VBox>

</StackPane>