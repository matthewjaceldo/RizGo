<?xml version="1.0" encoding="UTF-8"?>

<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
         https://maven.apache.org/xsd/maven-4.0.0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <groupId>com.rizgo</groupId>
    <artifactId>RizGo</artifactId>
    <version>1.0-SNAPSHOT</version>

    <properties>

        <project.build.sourceEncoding>
            UTF-8
        </project.build.sourceEncoding>

        <maven.compiler.source>
            17
        </maven.compiler.source>

        <maven.compiler.target>
            17
        </maven.compiler.target>

        <java.version>
            17
        </java.version>

        <javafx.version>
            21.0.2
        </javafx.version>

        <gluonfx.version>
            1.0.29
        </gluonfx.version>

        <!-- Desktop unless Android profile is selected -->
        <gluonfx.target>
            host
        </gluonfx.target>

        <mainClass>
            com.rizgo/com.rizgo.Main
        </mainClass>

    </properties>


    <!-- ===================================================== -->
    <!-- DEPENDENCIES                                          -->
    <!-- ===================================================== -->

    <dependencies>

        <!-- JavaFX Controls -->

        <dependency>

            <groupId>
                org.openjfx
            </groupId>

            <artifactId>
                javafx-controls
            </artifactId>

            <version>
                ${javafx.version}
            </version>

        </dependency>


        <!-- JavaFX FXML -->

        <dependency>

            <groupId>
                org.openjfx
            </groupId>

            <artifactId>
                javafx-fxml
            </artifactId>

            <version>
                ${javafx.version}
            </version>

        </dependency>


        <!-- JavaFX Web -->

        <dependency>

            <groupId>
                org.openjfx
            </groupId>

            <artifactId>
                javafx-web
            </artifactId>

            <version>
                ${javafx.version}
            </version>

        </dependency>


        <!-- SQLite -->

        <dependency>

            <groupId>
                org.xerial
            </groupId>

            <artifactId>
                sqlite-jdbc
            </artifactId>

            <version>
                3.53.1.0
            </version>

        </dependency>


        <!-- SLF4J -->

        <dependency>

            <groupId>
                org.slf4j
            </groupId>

            <artifactId>
                slf4j-api
            </artifactId>

            <version>
                2.0.17
            </version>

        </dependency>


        <dependency>

            <groupId>
                org.slf4j
            </groupId>

            <artifactId>
                slf4j-simple
            </artifactId>

            <version>
                2.0.17
            </version>

        </dependency>

    </dependencies>


    <!-- ===================================================== -->
    <!-- BUILD                                                 -->
    <!-- ===================================================== -->

    <build>

        <plugins>


            <!-- ================================================= -->
            <!-- JAVA COMPILER                                     -->
            <!-- ================================================= -->

            <plugin>

                <groupId>
                    org.apache.maven.plugins
                </groupId>

                <artifactId>
                    maven-compiler-plugin
                </artifactId>

                <version>
                    3.13.0
                </version>

                <configuration>

                    <release>
                        17
                    </release>

                </configuration>

            </plugin>


            <!-- ================================================= -->
            <!-- NORMAL DESKTOP JAVAFX                             -->
            <!-- ================================================= -->

            <plugin>

                <groupId>
                    org.openjfx
                </groupId>

                <artifactId>
                    javafx-maven-plugin
                </artifactId>

                <version>
                    0.0.8
                </version>

                <configuration>

                    <mainClass>
                        ${mainClass}
                    </mainClass>

                </configuration>

            </plugin>


            <!-- ================================================= -->
            <!-- GLUONFX                                          -->
            <!-- ================================================= -->

            <plugin>

                <groupId>
                    com.gluonhq
                </groupId>

                <artifactId>
                    gluonfx-maven-plugin
                </artifactId>

                <version>
                    ${gluonfx.version}
                </version>

                <configuration>

                    <target>
                        ${gluonfx.target}
                    </target>

                    <mainClass>
                        ${mainClass}
                    </mainClass>


                    <!-- ========================================= -->
                    <!-- APP INFORMATION                           -->
                    <!-- ========================================= -->

                    <releaseConfiguration>

                        <appLabel>
                            RizGo
                        </appLabel>

                        <versionCode>
                            1
                        </versionCode>

                        <versionName>
                            1.0
                        </versionName>

                    </releaseConfiguration>


                    <!-- ========================================= -->
                    <!-- FXML / REFLECTION                         -->
                    <!-- ========================================= -->

                    <reflectionList>

                        <list>
                            com.rizgo.controllers.AboutController
                        </list>

                        <list>
                            com.rizgo.controllers.AnnouncementsController
                        </list>

                        <list>
                            com.rizgo.controllers.BuildingController
                        </list>

                        <list>
                            com.rizgo.controllers.ChatbotController
                        </list>

                        <list>
                            com.rizgo.controllers.DashboardController
                        </list>

                        <list>
                            com.rizgo.controllers.DirectoryController
                        </list>

                        <list>
                            com.rizgo.controllers.EmergencyController
                        </list>

                        <list>
                            com.rizgo.controllers.EventsController
                        </list>

                        <list>
                            com.rizgo.controllers.FacilitiesController
                        </list>

                        <list>
                            com.rizgo.controllers.LoginController
                        </list>

                        <list>
                            com.rizgo.controllers.MapController
                        </list>

                        <list>
                            com.rizgo.controllers.OfficesController
                        </list>

                        <list>
                            com.rizgo.controllers.ProfileController
                        </list>

                        <list>
                            com.rizgo.controllers.RoleSelectionController
                        </list>

                        <list>
                            com.rizgo.controllers.SearchController
                        </list>

                        <list>
                            com.rizgo.controllers.ServicesController
                        </list>

                        <list>
                            com.rizgo.controllers.SettingsController
                        </list>

                        <list>
                            com.rizgo.controllers.SignupController
                        </list>

                        <list>
                            com.rizgo.controllers.SplashController
                        </list>

                    </reflectionList>


                    <!-- ========================================= -->
                    <!-- RESOURCES                                 -->
                    <!-- ========================================= -->

                    <resourcesList>

                        <list>
                            fxml/.*
                        </list>

                        <list>
                            css/.*
                        </list>

                        <list>
                            images/.*
                        </list>

                    </resourcesList>

                </configuration>

            </plugin>

        </plugins>

    </build>


    <!-- ===================================================== -->
    <!-- PLATFORM PROFILES                                     -->
    <!-- ===================================================== -->

    <profiles>


        <!-- DESKTOP -->

        <profile>

            <id>
                desktop
            </id>

            <activation>

                <activeByDefault>
                    true
                </activeByDefault>

            </activation>

            <properties>

                <gluonfx.target>
                    host
                </gluonfx.target>

            </properties>

        </profile>


        <!-- ANDROID -->

        <profile>

            <id>
                android
            </id>

            <properties>

                <gluonfx.target>
                    android
                </gluonfx.target>

            </properties>

        </profile>

    </profiles>

</project>